    "version": "0.2.0",
    "configurations": [
        {
            "name":"Rerun import",
            "type":"debugpy",
            "request":"launch",
            "program":"${workspaceFolder}/scripts/visualize_tracking_results.py",
            "console":"integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "args":[
                "${workspaceFolder}/tracking_tests/cross-cam-outlier-reject_proc_noise_0_2/tracking_results.csv",
                "-o", "${workspaceFolder}/tracking_viz_cameras.rrd",
                "--cameras", "/mnt/d/mocap/2026-01-11-kotegaesh-joint-space-test/Calib_scene.toml",
                "--video-dir", "/mnt/d/mocap/2026-01-11-kotegaesh-joint-space-test/videos",
                "--skeleton", "${workspaceFolder}/tests/data/Harri_skeleton-shouldery-rot.yaml",
                "--sync", "${workspaceFolder}/tests/cpp-python/sync_cpp-python-full.json"
            ]
        },
            {
            "type": "lldb",
            "request": "launch",
            "name": "Custom launch",
            "targetCreateCommands": [
                "target create ${workspaceFolder}/builddir/tests/test_posetrak"
            ],
            "processCreateCommands": [
                "process launch"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "C++ - Python test",
            "targetCreateCommands": [
                "target create ${workspaceFolder}/builddir/cli/posetrak"
            ],
            "args": ["${workspaceFolder}/tests/harri-no-palms.toml"],
            "processCreateCommands": [
                "process launch"
            ]
        },
        {
        "name": "test_posetrak",
        "miDebuggerPath": "/usr/bin/gdb",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceRoot}/builddir/tests/test_posetrak",
        "args": [],
        "cwd": "${workspaceRoot}"
    },
        {
        "name": "Posetrack gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/builddir/cli/posetrak",
        "args": ["${workspaceFolder}/tests/harri-no-palms.toml"],
        "cwd": "${workspaceRoot}"
    },


    ],
}
